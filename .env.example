# Flask 配置
SECRET_KEY=change-me-in-production
# JWT 签名密钥（默认复用 SECRET_KEY）
JWT_SECRET=
# Token 有效期（小时）
JWT_EXPIRES_HOURS=24

# 数据库：默认 SQLite；生产建议 MySQL
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/lab_system?charset=utf8mb4
# DATABASE_URL=sqlite:///instance/lab.db

# 上传目录与单次请求大小上限（字节）
UPLOAD_FOLDER=
MAX_CONTENT_LENGTH=52428800

# 允许跨域的前端地址，多个用逗号分隔；* 表示全部
CORS_ORIGINS=*

# AI 智能建议（/agent/ask）可选接入
AI_API_BASE=
AI_API_KEY=
AI_MODEL=